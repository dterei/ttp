        0x4cc5d4becb3e42b6 0x597f299cfc657e2a 0x5fcb6fab3ad6faec 0x6c44198c4a475817
    )
    h=(
        0x6a09e667f3bcc908 0xbb67ae8584caa73b 0x3c6ef372fe94f82b 0xa54ff53a5f1d36f1
        0x510e527fade682d1 0x9b05688c2b3e6c1f 0x1f83d9abfb41bd6b 0x5be0cd19137e2179
    )
    local n=${#hash_in[@]} i t a b c d e f g hh s0 s1 t1 t2 x
    m=("${hash_in[@]}" 128)
    while (( ${#m[@]} % 128 != 112 )); do
        m+=(0)
    done
    m+=(0 0 0 0 0 0 0 0)
    for ((i = 56; i >= 0; i -= 8)); do
        m+=($(( n * 8 >> i & 255 )))
    done
    for ((i = 0; i < ${#m[@]}; i += 128)); do
        for ((t = 0; t < 16; t++)); do
            x=$(( i + 8 * t ))
            w[t]=$(( m[x] << 56 | m[x+1] << 48 | m[x+2] << 40 | m[x+3] << 32 | m[x+4] << 24 | m[x+5] << 16 | m[x+6] << 8 | m[x+7] ))
        done
        for ((t = 16; t < 80; t++)); do
            x=${w[t-15]}
            s0=$(( (x >> 1 & 0x7FFFFFFFFFFFFFFF | x << 63) ^ (x >> 8 & 0x7FFFFFFFFFFFFFFF >> 7 | x << 56) ^ (x >> 7 & 0x7FFFFFFFFFFFFFFF >> 6) ))
            x=${w[t-2]}
            s1=$(( (x >> 19 & 0x7FFFFFFFFFFFFFFF >> 18 | x << 45) ^ (x >> 61 & 7 | x << 3) ^ (x >> 6 & 0x7FFFFFFFFFFFFFFF >> 5) ))
