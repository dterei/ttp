# Installation:
#   Just put it somewhere on your path (e.g., $HOME/bin/ttp).
#
# Requirements:
#   bash, gnupg (plus mkdir, and date on bash < 5)
#
# Optional dependencies (see README.md for details):
#   wl-copy - to send login codes to the Wayland clipboard instead of stdout
#   xclip, xsel - to send login codes to the X clipboard instead of stdout
#   pbcopy - to send login codes to the OSX clipboard instead of stdout
#   zbar - to parse QR codes from screen with -c option
#   qrencode - to display QR codes with -v option
#   imagemagick, xv or xloadimage - to show -v QR codes in an X11 window
#   gsettings - to warn if GNOME caches gpg passphrases indefinitely

# Tip: To move keys from Google Authenticator, use its "Transfer
# accounts" > "Export accounts" option, then run "ttp -c service" with
# the export QR code on screen, or paste its otpauth-migration:// URI
# at the key prompt.  Repeat for each account you want.


prog=${0##*/}
keydir="${XDG_CONFIG_HOME-${HOME}/.config}/ttp"
gpgcmd="gpg"
# Where gk reads answers from; the tests point it at a file.
ttydev=/dev/tty
gpgoptions=(--pinentry-mode loopback -q)
# Encrypt keys with AES-256, and derive the key from the passphrase with
# SHA-512 iterated as many times as gpg allows, so a stolen key file is
# as slow as possible to attack.  Recent gpg does this by default, but
# older versions use AES-128 or fewer iterations.
gpgencrypt=(--cipher-algo AES256 --s2k-cipher-algo AES256
            --s2k-digest-algo SHA512 --s2k-mode 3 --s2k-count 65011712)

usage() {
    echo "usage: $prog [-x] service     # get token for service" >&2
    echo "       $prog -[x]c service    # record seed for new service" >&2
    echo "       $prog -[x]v service    # view qrcode for service" >&2
    echo "       $prog -l               # list services setup" >&2
    echo "(The -x* flags disable use of X11 and Wayland even when they are available.)" >&2
    exit 1
}

# Google authenticator code calculation in pure bash.  Bash integers
# are 64 bits, which is enough to do SHA-1's 32-bit arithmetic.  Byte
# strings are arrays of integers 0-255, passed in globals because bash
# 3 (as shipped on OS X) has no namerefs.

# SHA-1 of the bytes in sha1_in; result goes in sha1_out.
sha1() {
    local -a m w
    local n=${#sha1_in[@]} i t a b c d e f k tmp h
    local h0=0x67452301 h1=0xEFCDAB89 h2=0x98BADCFE h3=0x10325476 h4=0xC3D2E1F0
    m=("${sha1_in[@]}" 128)
    while (( ${#m[@]} % 64 != 56 )); do
        m+=(0)
    done
    for ((i = 56; i >= 0; i -= 8)); do
        m+=($(( n * 8 >> i & 255 )))
    done
    for ((i = 0; i < ${#m[@]}; i += 64)); do
        for ((t = 0; t < 16; t++)); do
            w[t]=$(( m[i+4*t] << 24 | m[i+4*t+1] << 16 | m[i+4*t+2] << 8 | m[i+4*t+3] ))
        done
        for ((t = 16; t < 80; t++)); do
            tmp=$(( w[t-3] ^ w[t-8] ^ w[t-14] ^ w[t-16] ))
            w[t]=$(( (tmp << 1 | tmp >> 31) & 0xFFFFFFFF ))
        done
        a=$h0 b=$h1 c=$h2 d=$h3 e=$h4
        for ((t = 0; t < 80; t++)); do
            if ((t < 20)); then
                f=$(( (b & c) | (~b & d) )) k=0x5A827999
            elif ((t < 40)); then
                f=$(( b ^ c ^ d )) k=0x6ED9EBA1
            elif ((t < 60)); then
                f=$(( (b & c) | (b & d) | (c & d) )) k=0x8F1BBCDC
            else
                f=$(( b ^ c ^ d )) k=0xCA62C1D6
            fi
            tmp=$(( ((a << 5 | a >> 27) + f + e + k + w[t]) & 0xFFFFFFFF ))
            e=$d d=$c c=$(( (b << 30 | b >> 2) & 0xFFFFFFFF )) b=$a a=$tmp
        done
        h0=$(( (h0 + a) & 0xFFFFFFFF ))
        h1=$(( (h1 + b) & 0xFFFFFFFF ))
        h2=$(( (h2 + c) & 0xFFFFFFFF ))
        h3=$(( (h3 + d) & 0xFFFFFFFF ))
        h4=$(( (h4 + e) & 0xFFFFFFFF ))
    done
    sha1_out=()
    for h in $h0 $h1 $h2 $h3 $h4; do
        sha1_out+=($(( h >> 24 & 255 )) $(( h >> 16 & 255 )) \
                   $(( h >> 8 & 255 )) $(( h & 255 )))
    done
}

# HMAC-SHA1 of hmac_msg with key hmac_key; result goes in sha1_out.
hmac_sha1() {
    local -a k ipad opad
    local i
    k=("${hmac_key[@]}")
    if ((${#k[@]} > 64)); then
        sha1_in=("${k[@]}")
        sha1
        k=("${sha1_out[@]}")
    fi
    for ((i = 0; i < 64; i++)); do
        ipad[i]=$(( ${k[i]:-0} ^ 0x36 ))
        opad[i]=$(( ${k[i]:-0} ^ 0x5c ))
    done
    sha1_in=("${ipad[@]}" "${hmac_msg[@]}")
    sha1
    sha1_in=("${opad[@]}" "${sha1_out[@]}")
    sha1
}


# Read a base32 secret or otpauth://totp/ URI from stdin and print its
# code for Unix time $1 (default: now).  URIs may set digits and period;
# only SHA1, the default, is supported as the algorithm.
totp() {
    local b32=ABCDEFGHIJKLMNOPQRSTUVWXYZ234567abcdefghijklmnopqrstuvwxyz
    local ws=$' \t' line secret query param digits=6 period=30 algorithm=SHA1
    local have_secret='' now i p acc=0 bits=0
    if ! IFS= read -r line && test -z "$line"; then
        # If gpg or something fails on input.  But allow null key with \n.
        echo "$prog: aborted" >&2
        return 1
    fi
    case "$line" in
        otpauth://totp/*'?'*)
            query=${line#*'?'}
            while test -n "$query"; do
                param=${query%%&*}
                case "$query" in
                    *'&'*) query=${query#*&} ;;
                    *) query= ;;
                esac
                case "$param" in
                    secret=*) secret=${param#secret=} have_secret=1 ;;
                    digits=*) digits=${param#digits=} ;;
                    period=*) period=${param#period=} ;;
                    algorithm=*) algorithm=${param#algorithm=} ;;
                esac
            done
            if test -z "$have_secret"; then
                echo "$prog: bad key" >&2
                return 1
            fi
            ;;
        otpauth://*)
            echo "$prog: bad key" >&2
            return 1
            ;;
        *)
            secret=$line
            ;;
    esac

    # These are checked as strings before any arithmetic, because bash
    # arithmetic would evaluate expressions hidden in them.
    case "$algorithm" in
        SHA1|sha1) ;;
        *)
            echo "$prog: unsupported algorithm: $algorithm (only SHA1 is supported)" >&2
            return 1
            ;;
    esac
    case "$digits" in
        [1-9]|10) ;;
        *)
            echo "$prog: unsupported number of digits: $digits" >&2
            return 1
            ;;
    esac
    case "$period" in
        ''|0*|*[!0-9]*|??????????*)
            echo "$prog: unsupported period: $period" >&2
            return 1
            ;;
    esac

    # Ignore whitespace and any trailing "=" padding.
    secret=${secret//[$ws]/}
    while test "${secret%=}" != "$secret"; do
        secret=${secret%=}
    done
    case $(( ${#secret} & 7 )) in
        1|3|6)
            echo "$prog: bad key" >&2
            return 1
            ;;
    esac
    hmac_key=()
    for ((i = 0; i < ${#secret}; i++)); do
        p=${b32%%"${secret:i:1}"*}
        if test ${#p} -eq ${#b32}; then
            echo "$prog: bad key" >&2
            return 1
        fi
        acc=$(( acc << 5 | (${#p} & 31) )) bits=$(( bits + 5 ))
        if ((bits >= 8)); then
            bits=$(( bits - 8 ))
            hmac_key+=($(( acc >> bits & 255 )))
            acc=$(( acc & ((1 << bits) - 1) ))
        fi
    done

    now=${1:-${EPOCHSECONDS:-$(date +%s)}}
    hmac_msg=()
    for ((i = 56; i >= 0; i -= 8)); do
        hmac_msg+=($(( now / period >> i & 255 )))
    done

    hmac_sha1
    i=$(( sha1_out[19] & 15 ))
    # Keep this on one line: bash 4.0 reads "<<" in arithmetic that
    # spans lines as the start of a here-document.
    p=$(( (sha1_out[i] & 127) << 24 | sha1_out[i+1] << 16 | sha1_out[i+2] << 8 | sha1_out[i+3] ))
    printf "%0${digits}d\n" $(( p % 10 ** digits ))
}

# Print bytes $@ as base32, without padding.
base32_encode() {
    local alphabet=ABCDEFGHIJKLMNOPQRSTUVWXYZ234567 out='' acc=0 bits=0 b
    for b in "$@"; do
        acc=$(( acc << 8 | b )) bits=$(( bits + 8 ))
        while ((bits >= 5)); do
            bits=$(( bits - 5 ))
            out+=${alphabet:$(( acc >> bits & 31 )):1}
        done
        acc=$(( acc & ((1 << bits) - 1) ))
    done
    if ((bits > 0)); then
        out+=${alphabet:$(( acc << (5 - bits) & 31 )):1}
    fi
    echo "$out"
}

# Print bytes $@ percent-encoded for use in a URI, keeping letters,
# digits and -._~:@ as they are.
uri_encode() {
    local out='' b c
    for b in "$@"; do
        if (( (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
              || b == 45 || b == 46 || b == 95 || b == 126 || b == 58 || b == 64 )); then
            # Format the byte as an octal escape, without a subshell.
            # shellcheck disable=SC2059
            printf -v c "\\$(( b >> 6 ))$(( b >> 3 & 7 ))$(( b & 7 ))"
            out+=$c
        else
            printf -v c '%%%02X' "$b"
            out+=$c
        fi
    done
    echo "$out"
}

# Protobuf helpers for migration_uris.  They read the array pb from
# position pos up to end, all variables of the caller.

# Read a varint into v.
pb_varint() {
    local b shift=0
    v=0
    while ((pos < end)); do
        b=${pb[pos]} pos=$(( pos + 1 ))
        v=$(( v | (b & 127) << shift ))
        if ((b < 128)); then
            return 0
        fi
        shift=$(( shift + 7 ))
        if ((shift > 63)); then
            return 1
        fi
    done
    return 1
}

# Skip a field of wire type $1.
pb_skip() {
    case $1 in
        0) pb_varint || return 1 ;;
        1) pos=$(( pos + 8 )) ;;
        2) pb_varint || return 1; pos=$(( pos + v )) ;;
        5) pos=$(( pos + 4 )) ;;
        *) return 1 ;;
    esac
    ((pos <= end))
}

# Read a length-delimited field's bytes into the array field.
pb_bytes() {
    pb_varint || return 1
    if ((v > end - pos)); then
        return 1
    fi
    field=("${pb[@]:pos:v}")
    pos=$(( pos + v ))
}

# Print one otpauth://totp/ URI for the OtpParameters message that ends
# at $1, starting at pos.
migration_account() {
    local end=$1 key v type=0 algorithm=0 digits=0 label issuer uri
    local -a field secret name issuer_bytes
    while ((pos < end)); do
        pb_varint || return 1
        key=$v
        case $key in
            10) pb_bytes || return 1; secret=("${field[@]}") ;;
            18) pb_bytes || return 1; name=("${field[@]}") ;;
            26) pb_bytes || return 1; issuer_bytes=("${field[@]}") ;;
            32) pb_varint || return 1; algorithm=$v ;;
            40) pb_varint || return 1; digits=$v ;;
            48) pb_varint || return 1; type=$v ;;
            *) pb_skip $(( key & 7 )) || return 1 ;;
        esac
    done

    label=$(uri_encode "${name[@]}")
    issuer=$(uri_encode "${issuer_bytes[@]}")
    if test "$type" = 1; then
        echo "$prog: skipping $label: counter-based (HOTP) keys are not supported" >&2
        return 0
    fi
    if test -n "$issuer"; then
        case "$label" in
            "$issuer":*) ;;
            *) label="$issuer:$label" ;;
        esac
    fi
    uri="otpauth://totp/$label?secret=$(base32_encode "${secret[@]}")"
    if test -n "$issuer"; then
        uri+="&issuer=$issuer"
    fi
    case $algorithm in
        0|1) ;;
        2) uri+="&algorithm=SHA256" ;;
        3) uri+="&algorithm=SHA512" ;;
        4) uri+="&algorithm=MD5" ;;
        *) uri+="&algorithm=unknown" ;;
    esac
    if test "$digits" = 2; then
        uri+="&digits=8"
    fi
    echo "$uri"
}

# Print an otpauth://totp/ URI for each TOTP key in a Google
# Authenticator export, otpauth-migration://offline?data=..., where data
# is a base64 MigrationPayload protobuf.
migration_uris() {
    local b64=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/
    local query param data='' i c p acc=0 bits=0 pos=0 end v key
    local -a pb
    query=${1#*'?'}
    while test -n "$query"; do
        param=${query%%&*}
        case "$query" in
            *'&'*) query=${query#*&} ;;
            *) query= ;;
        esac
        case "$param" in
            data=*) data=${param#data=} ;;
        esac
    done
    # Undo the URI encoding of the base64 characters + / and =.
    data=${data//%2B/+} data=${data//%2b/+}
    data=${data//%2F//} data=${data//%2f//}
    data=${data//%3D/=} data=${data//%3d/=}
    while test "${data%=}" != "$data"; do
        data=${data%=}
    done
    for ((i = 0; i < ${#data}; i++)); do
        c=${data:i:1}
        case "$c" in
            -) p=62 ;;
            _) p=63 ;;
            *)
                p=${b64%%"$c"*}
                p=${#p}
                if ((p == 64)); then
                    echo "$prog: bad Google Authenticator export" >&2
                    return 1
                fi
                ;;
        esac
        acc=$(( acc << 6 | p )) bits=$(( bits + 6 ))
        if ((bits >= 8)); then
            bits=$(( bits - 8 ))
            pb+=($(( acc >> bits & 255 )))
            acc=$(( acc & ((1 << bits) - 1) ))
        fi
    done

    # MigrationPayload: field 1 holds each key's OtpParameters.
    end=${#pb[@]}
    while ((pos < end)); do
        if ! pb_varint; then
            echo "$prog: bad Google Authenticator export" >&2
            return 1
        fi
        key=$v
        if test "$key" = 10; then
            if ! pb_varint || ((v > end - pos)) \
                    || ! migration_account $(( pos + v )); then
                echo "$prog: bad Google Authenticator export" >&2
                return 1
            fi
        elif ! pb_skip $(( key & 7 )); then
            echo "$prog: bad Google Authenticator export" >&2
            return 1
        fi
    done
}

# Turn zbarimg output ("QR-Code:" lines) or pasted URIs into one
# otpauth://totp/ URI per line, expanding Google Authenticator exports.
qr_uris() {
    local line
    while IFS= read -r line; do
        line=${line#QR-Code:}
        case "$line" in
            otpauth://totp/*) echo "$line" ;;
            otpauth-migration://*) migration_uris "$line" ;;
        esac
    done
}

# Pick one of the URIs on stdin, asking which to use.
gk() {
    local uri account ans
    # Stdin is a pipe and stdout is captured, so ask on stderr and read
    # the answers from the terminal.
    while IFS= read -r uri; do
        account=${uri#otpauth://totp/}
        account=${account%%\?*}
        echo -n "Use $account? (y) " >&2
        read -r ans <&3
        if test x"$ans" = x -o y = "$ans" -o yes = "$ans"; then
            echo "$uri"
            return
        fi
    done 3< "$ttydev"
}

# Exit with an error unless a key is stored for service $1.
need_key() {
    if ! test -f "$keydir/$1.gpg"; then
        echo "$prog: no key for $1 (run '$prog -l' to list them)" >&2
        exit 1
    fi
}

main() {
    local mode target code key secret f

    # Never write a core dump, which could hold a key.
    ulimit -c 0 2> /dev/null

    if [[ "$OSTYPE" == "darwin"* ]]; then
        export DISPLAY="<OSX>"
    fi

    case "$1" in
        -x)
            shift
            unset DISPLAY WAYLAND_DISPLAY
            ;;
        -x*)
            unset DISPLAY WAYLAND_DISPLAY
            ;;
    esac
    case $# in
        1)
            case "$1" in
                -l) mode=-l ;;
                -*) usage ;;
                *) mode='' target=$1 ;;
            esac
            ;;
        2)
            mode=$1 target=$2
            ;;
        *)
            usage
            ;;
    esac
    # Names become file names, and -l doesn't list hidden files.
    if test "$mode" != -l; then
        case "$target" in
            ''|-*|.*|*/*)
                echo "$prog: invalid service name: '$target' (names can't be empty, contain '/', or start with '-' or '.')" >&2
                exit 1
                ;;
        esac
    fi

    case $(gsettings get org.gnome.crypto.cache gpg-cache-method 2>/dev/null) in
        "'idle'"|"'timeout'"|"")
            ;;
        *)
            echo "WARNING:  gnome-keyring-daemon is not configured to forget passwords." >&2
            echo "          It is strongly suggested that you run the following command:" >&2
            echo "          gsettings set org.gnome.crypto.cache gpg-cache-method idle" >&2
            ;;
    esac

    case "$mode" in
        "")
            need_key "$target"
            code=$("$gpgcmd" "${gpgoptions[@]}" -d "$keydir/$target.gpg" | totp) || exit 1
            if test -n "$WAYLAND_DISPLAY" && command -v wl-copy > /dev/null; then
                echo "Sending code to Wayland clipboard"
                printf '%s' "$code" | wl-copy
            elif test -n "$DISPLAY" && command -v xclip > /dev/null; then
                echo "Sending code to X clipboard"
                printf '%s' "$code" | xclip -selection clipboard -i
            elif test -n "$DISPLAY" && command -v xsel > /dev/null; then
                echo "Sending code to X clipboard"
                printf '%s' "$code" | xsel --clipboard --input
            elif test -n "$DISPLAY" && command -v pbcopy > /dev/null; then
                echo "Sending code to OSX clipboard"
                printf '%s' "$code" | pbcopy
            else
                echo "$code"
            fi
            ;;
        -c|-xc)
            umask 077
            if test -e "$keydir/$target.gpg"; then
                echo "$prog: $keydir/$target.gpg exists already; please delete it." >&2
                exit 1
            fi
            mkdir -p "$keydir" || exit 1
            key=
            if test -n "$DISPLAY"; then
                key=$(zbarimg x:root 2> /dev/null | qr_uris | gk)
            fi
            if test -z "$key"; then
                echo -n "Enter Base32-encoded authenticator key: "
                IFS= read -r key
                case "$key" in
                    otpauth-migration://*)
                        key=$(printf '%s\n' "$key" | qr_uris | gk)
                        ;;
                esac
                if test -z "$key"; then
                    echo "Aborted."
                    exit 0
                fi
            fi
            printf '%s\n' "$key" | totp 0 > /dev/null || exit 1
            printf '%s\n' "$key" \
                | "$gpgcmd" "${gpgoptions[@]}" "${gpgencrypt[@]}" -c \
                    -o "$keydir/$target.gpg" || exit 1
            ;;
        -v|-xv)
            need_key "$target"
            secret=$("$gpgcmd" "${gpgoptions[@]}" -d "$keydir/$target.gpg") || exit 1
            case "$secret" in
                otpauth://totp/*)
                    ;;
                *)
                    secret="otpauth://totp/$target?secret=$secret&issuer=$target"
                    ;;
            esac
            secret=${secret// /}
            if test -z "$DISPLAY"; then
                printf '%s' "$secret" | qrencode -t ansi
            elif command -v display > /dev/null; then
                printf '%s' "$secret" | qrencode -o- | display -
            elif command -v xv > /dev/null; then
                printf '%s' "$secret" | qrencode -o- | xv -
            elif command -v xloadimage > /dev/null; then
                printf '%s' "$secret" | qrencode -o- | xloadimage stdin
            else
                printf '%s' "$secret" | qrencode -t ansi
            fi
            ;;
        -l)
            for f in "$keydir"/*.gpg; do
                test -f "$f" || continue
                f=${f##*/}
                echo "${f%.gpg}"
            done
            ;;
        *)
            usage
            ;;
    esac
}

# Only run when executed, so the test suite can source this file.
if test "${BASH_SOURCE[0]}" = "$0"; then
    main "$@"
fi
