prog=${0##*/}
keydir="${XDG_CONFIG_HOME-${HOME}/.config}/ttp"
gpgcmd="gpg"
# Where gk reads answers from; the tests point it at a file.
ttydev=/dev/tty
gpgoptions=(--pinentry-mode loopback -q)
# Encrypt keys with AES-256, and derive the key from the passphrase with
# SHA-512 iterated as many times as gpg allows, so a stolen key file is
# as slow as possible to attack.  Recent gpg does this by default, but
# older versions use AES-128 or fewer iterations.
gpgencrypt=(--cipher-algo AES256 --s2k-cipher-algo AES256
            --s2k-digest-algo SHA512 --s2k-mode 3 --s2k-count 65011712)

usage() {
    echo "usage: $prog [-x] service     # get token for service" >&2
    echo "       $prog -[x]c service    # record seed for new service" >&2
    echo "       $prog -[x]v service    # view qrcode for service" >&2
    echo "       $prog -l               # list services setup" >&2
    echo "(The -x* flags disable use of X11 and Wayland even when they are available.)" >&2
    exit 1
}

# Google authenticator code calculation in pure bash.  Bash integers
# are 64 bits: enough for the 32-bit arithmetic of SHA-1 and SHA-256, and
# they wrap around as SHA-512's 64-bit arithmetic needs.  Byte strings
# are arrays of integers 0-255, passed in globals because bash 3 (as
# shipped on OS X) has no namerefs.  Arithmetic using "<<" stays on one
# line, because bash 4.0 reads it across lines as a here-document.

# SHA-1 of the bytes in hash_in; result goes in hash_out.
sha1() {
    local -a m w
    local n=${#hash_in[@]} i t a b c d e f k tmp h
    local h0=0x67452301 h1=0xEFCDAB89 h2=0x98BADCFE h3=0x10325476 h4=0xC3D2E1F0
    m=("${hash_in[@]}" 128)
    while (( ${#m[@]} % 64 != 56 )); do
        m+=(0)
    done
    for ((i = 56; i >= 0; i -= 8)); do
        m+=($(( n * 8 >> i & 255 )))
    done
    for ((i = 0; i < ${#m[@]}; i += 64)); do
        for ((t = 0; t < 16; t++)); do
            w[t]=$(( m[i+4*t] << 24 | m[i+4*t+1] << 16 | m[i+4*t+2] << 8 | m[i+4*t+3] ))
        done
        for ((t = 16; t < 80; t++)); do
            tmp=$(( w[t-3] ^ w[t-8] ^ w[t-14] ^ w[t-16] ))
            w[t]=$(( (tmp << 1 | tmp >> 31) & 0xFFFFFFFF ))
        done
        a=$h0 b=$h1 c=$h2 d=$h3 e=$h4
        for ((t = 0; t < 80; t++)); do
            if ((t < 20)); then
                f=$(( (b & c) | (~b & d) )) k=0x5A827999
            elif ((t < 40)); then
                f=$(( b ^ c ^ d )) k=0x6ED9EBA1
            elif ((t < 60)); then
                f=$(( (b & c) | (b & d) | (c & d) )) k=0x8F1BBCDC
            else
                f=$(( b ^ c ^ d )) k=0xCA62C1D6
            fi
            tmp=$(( ((a << 5 | a >> 27) + f + e + k + w[t]) & 0xFFFFFFFF ))
            e=$d d=$c c=$(( (b << 30 | b >> 2) & 0xFFFFFFFF )) b=$a a=$tmp
        done
        h0=$(( (h0 + a) & 0xFFFFFFFF ))
        h1=$(( (h1 + b) & 0xFFFFFFFF ))
        h2=$(( (h2 + c) & 0xFFFFFFFF ))
        h3=$(( (h3 + d) & 0xFFFFFFFF ))
        h4=$(( (h4 + e) & 0xFFFFFFFF ))
    done
    hash_out=()
    for h in $h0 $h1 $h2 $h3 $h4; do
        hash_out+=($(( h >> 24 & 255 )) $(( h >> 16 & 255 )) \
                   $(( h >> 8 & 255 )) $(( h & 255 )))
    done
}

# SHA-256 of the bytes in hash_in; result goes in hash_out.
sha256() {
    local -a m w k h
    k=(
        0x428a2f98 0x71374491 0xb5c0fbcf 0xe9b5dba5 0x3956c25b 0x59f111f1 0x923f82a4 0xab1c5ed5
        0xd807aa98 0x12835b01 0x243185be 0x550c7dc3 0x72be5d74 0x80deb1fe 0x9bdc06a7 0xc19bf174
        0xe49b69c1 0xefbe4786 0x0fc19dc6 0x240ca1cc 0x2de92c6f 0x4a7484aa 0x5cb0a9dc 0x76f988da
        0x983e5152 0xa831c66d 0xb00327c8 0xbf597fc7 0xc6e00bf3 0xd5a79147 0x06ca6351 0x14292967
        0x27b70a85 0x2e1b2138 0x4d2c6dfc 0x53380d13 0x650a7354 0x766a0abb 0x81c2c92e 0x92722c85
        0xa2bfe8a1 0xa81a664b 0xc24b8b70 0xc76c51a3 0xd192e819 0xd6990624 0xf40e3585 0x106aa070
        0x19a4c116 0x1e376c08 0x2748774c 0x34b0bcb5 0x391c0cb3 0x4ed8aa4a 0x5b9cca4f 0x682e6ff3
        0x748f82ee 0x78a5636f 0x84c87814 0x8cc70208 0x90befffa 0xa4506ceb 0xbef9a3f7 0xc67178f2
    )
    h=(
        0x6a09e667 0xbb67ae85 0x3c6ef372 0xa54ff53a 0x510e527f 0x9b05688c 0x1f83d9ab 0x5be0cd19
    )
    local n=${#hash_in[@]} i t a b c d e f g hh s0 s1 t1 t2 x
    m=("${hash_in[@]}" 128)
    while (( ${#m[@]} % 64 != 56 )); do
        m+=(0)
    done
    for ((i = 56; i >= 0; i -= 8)); do
        m+=($(( n * 8 >> i & 255 )))
    done
    for ((i = 0; i < ${#m[@]}; i += 64)); do
        for ((t = 0; t < 16; t++)); do
            w[t]=$(( m[i+4*t] << 24 | m[i+4*t+1] << 16 | m[i+4*t+2] << 8 | m[i+4*t+3] ))
        done
        for ((t = 16; t < 64; t++)); do
            x=${w[t-15]}
            s0=$(( ((x >> 7 | x << 25) ^ (x >> 18 | x << 14) ^ x >> 3) & 0xFFFFFFFF ))
            x=${w[t-2]}
            s1=$(( ((x >> 17 | x << 15) ^ (x >> 19 | x << 13) ^ x >> 10) & 0xFFFFFFFF ))
            w[t]=$(( (w[t-16] + s0 + w[t-7] + s1) & 0xFFFFFFFF ))
        done
        a=${h[0]} b=${h[1]} c=${h[2]} d=${h[3]} e=${h[4]} f=${h[5]} g=${h[6]} hh=${h[7]}
        for ((t = 0; t < 64; t++)); do
            s1=$(( ((e >> 6 | e << 26) ^ (e >> 11 | e << 21) ^ (e >> 25 | e << 7)) & 0xFFFFFFFF ))
            t1=$(( (hh + s1 + ((e & f) ^ (~e & g)) + k[t] + w[t]) & 0xFFFFFFFF ))
            s0=$(( ((a >> 2 | a << 30) ^ (a >> 13 | a << 19) ^ (a >> 22 | a << 10)) & 0xFFFFFFFF ))
            t2=$(( (s0 + ((a & b) ^ (a & c) ^ (b & c))) & 0xFFFFFFFF ))
            hh=$g g=$f f=$e e=$(( (d + t1) & 0xFFFFFFFF )) d=$c c=$b b=$a a=$(( (t1 + t2) & 0xFFFFFFFF ))
        done
        h=($(( (h[0] + a) & 0xFFFFFFFF )) $(( (h[1] + b) & 0xFFFFFFFF ))
           $(( (h[2] + c) & 0xFFFFFFFF )) $(( (h[3] + d) & 0xFFFFFFFF ))
           $(( (h[4] + e) & 0xFFFFFFFF )) $(( (h[5] + f) & 0xFFFFFFFF ))
           $(( (h[6] + g) & 0xFFFFFFFF )) $(( (h[7] + hh) & 0xFFFFFFFF )))
    done
    hash_out=()
    for x in "${h[@]}"; do
        hash_out+=($(( x >> 24 & 255 )) $(( x >> 16 & 255 )) $(( x >> 8 & 255 )) $(( x & 255 )))
    done
}

